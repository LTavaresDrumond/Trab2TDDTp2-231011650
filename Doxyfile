# Doxyfile - TP2 Trabalho 2
# Arquivo reduzido: as opções omitidas usam o valor padrão do Doxygen.
# Para ver todas as opções: doxygen -g Doxyfile.completo

PROJECT_NAME           = "TP2 - Trabalho 2: Sistema de Backup (TDD)"
PROJECT_NUMBER         = 1.0
PROJECT_BRIEF          = "Backup/restauração HD <-> pendrive guiado por Backup.parm"
OUTPUT_DIRECTORY       = doxygen
OUTPUT_LANGUAGE        = Brazilian
INPUT_ENCODING         = UTF-8

JAVADOC_AUTOBRIEF      = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES

INPUT                  = backup.hpp backup.cpp testa_backup.cpp
FILE_PATTERNS          = *.cpp *.hpp
RECURSIVE              = NO
# Não documentar o framework de teste nem pastas auxiliares
# (equivalente ao "EXCLUDE = catch.hpp" do enunciado, para o gtest).
EXCLUDE                = Docs doxygen scripts
EXCLUDE_PATTERNS       = */gtest/* */gmock/* catch.hpp

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
SOURCE_BROWSER         = YES
WARN_IF_UNDOCUMENTED   = YES
QUIET                  = NO
